# Copy this to .env at the repo root — it's the shared config the API, worker,
# and frontend all read (LiveKit, Groq, etc). backend/.env is a separate,
# optional local-dev override layered on top (e.g. pointing DATABASE_URL at
# localhost instead of the Docker Compose service name) — values there win
# over this file. Both are loaded by app/config.py regardless of which
# directory you run commands from.
#
# This file is for local Docker Compose use. Deploying to Railway as
# separate services (api / worker / frontend) means each service gets its
# own environment variables set in the Railway dashboard instead of one
# shared file — see docs/DEPLOYMENT.md for the full per-service matrix and
# what changes (DATABASE_URL's scheme, API_BASE_URL's hostname, CORS_ORIGINS'
# format, the frontend's build-time-only NEXT_PUBLIC_API_URL, etc).

# core
DATABASE_URL=postgresql+asyncpg://BOL:BOL@postgres:5432/BOL
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me
# Fernet key encrypting Tool secret headers (backend/app/services/crypto.py)
# — without it, saving a tool with a secret header (e.g. an Authorization
# bearer token) fails closed rather than storing it in plaintext. Generate
# with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_KEY=
# Where the worker reaches the API. Docker Compose: the service name shown
# here. Railway: http://<api-service-name>.railway.internal:<api's PORT> —
# private networking, not the api service's public domain.
API_BASE_URL=http://api:8000
# Build-time only (inlined into the JS bundle by `next build`) — setting
# this as a normal runtime env var on a deployed frontend does nothing. See
# frontend/Dockerfile and docs/DEPLOYMENT.md.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Origins the API accepts browser requests from — must include wherever the
# frontend actually runs, or every request fails CORS preflight. Accepts
# either this JSON-array form or a plain comma-separated string (e.g.
# CORS_ORIGINS=https://app.example.com) — see app/config.py.
CORS_ORIGINS=["http://localhost:3000"]

# livekit — create a free project at https://cloud.livekit.io
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Only needed for real PSTN outbound calls, not for browser test calls.
# A real trunk ID looks like ST_xxxxxxxx and only exists after creating an
# outbound trunk (see docs/TELEPHONY_SETUP.md) — it is NOT the SIP hostname
# shown in your LiveKit project settings.
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=

# groq — create a free API key at https://console.groq.com
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3.6-27b

# fish audio — pay-as-you-go API credit (https://fish.audio), NOT the Plus
# subscription (2.8x more expensive per minute of audio). s2.1-pro-free is
# free but the window is stated to end 2026-08-31 — switch FISH_MODEL to
# "s2-pro" (or its successor) before then. Prepay at least $100 to unlock
# 15 concurrent requests (5 below that) — this interacts with
# MAX_CONCURRENT_CALLS below if agents are using Fish.
FISH_API_KEY=
FISH_MODEL=s2.1-pro-free

# chatterbox — self-hosted TTS (see deploy/chatterbox/), reached over its
# OpenAI-compatible endpoint. Leave blank if not self-hosting. Include the
# /v1 suffix. ~5-6 concurrent calls per GPU running Turbo — also interacts
# with MAX_CONCURRENT_CALLS.
CHATTERBOX_BASE_URL=
CHATTERBOX_MODEL=chatterbox-turbo

# speech providers — see docs/LATENCY.md
# stt: livekit (streaming, default) | groq (batch, ~360ms slower) | local (Phase 6)
# tts: groq (hosted) | fish (hosted, streams) | chatterbox (self-hosted) | local
# This is the platform-wide default; individual agents can override it.
STT_PROVIDER=livekit
TTS_PROVIDER=groq
STT_SERVICE_URL=ws://stt:8020
TTS_SERVICE_URL=ws://tts:8021

# limits — if agents use Fish or Chatterbox, this should not exceed the
# smallest of: Fish's concurrency tier, (GPUs x ~5-6) for Chatterbox.
MAX_CONCURRENT_CALLS=5
FISH_MAX_CONCURRENT_CALLS=5
CHATTERBOX_MAX_CONCURRENT_CALLS=5

# call recording — LiveKit room-composite egress uploads each call's audio
# to this S3 bucket; leave blank to disable recording entirely. The bucket
# should NOT be public — playback URLs are presigned on demand by the API
# (app/services/recordings.py), short-lived, never stored.
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
