# Local-dev overrides layered on top of the repo-root .env (see there for
# LiveKit/Groq/etc). Only needed when running the API/worker natively
# (outside Docker Compose) — the root .env's defaults use Docker service
# names (postgres, api) that don't resolve outside the Compose network.
DATABASE_URL=postgresql+asyncpg://BOL:BOL@localhost:5432/BOL
JWT_SECRET=dev-secret-change-me
INTERNAL_SERVICE_TOKEN=dev-internal-token
CORS_ORIGINS=["http://localhost:3000"]
API_BASE_URL=http://localhost:8000
