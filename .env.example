# core
DATABASE_URL=postgresql+asyncpg://bol:bol@localhost:5432/bol
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
INTERNAL_SERVICE_TOKEN=change-me        # worker <-> API auth
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# livekit (create a free project at cloud.livekit.io) -- required from Phase 3a
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# AI provider -- defaults to "stub" so Phases 0-4 need zero LLM/speech accounts.
# Flip to "groq" only once Phase 3b is being worked on.
AI_PROVIDER=stub                        # stub | groq

# groq (create a free key at console.groq.com) -- leave blank until Phase 3b
GROQ_API_KEY=
LLM_MODEL=qwen/qwen3-32b
